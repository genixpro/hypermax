{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypermax.example/schemas/atpe2-evaluation-v1.json",
  "title": "ATPE2 offline configuration rollout",
  "type": "object",
  "required": [
    "state_id",
    "task_id",
    "generator_version",
    "history_lineage",
    "configuration",
    "rollout_seed",
    "repeat_index",
    "incumbent_curve",
    "failures",
    "timing",
    "dependency_versions"
  ],
  "properties": {
    "state_id": {"type": "string"},
    "task_id": {"type": "string"},
    "generator_version": {"type": "string"},
    "history_lineage": {"type": "string"},
    "configuration": {
      "type": "object",
      "required": [
        "gamma",
        "n_ei_candidates",
        "history_keep_fraction",
        "history_recency_bias",
        "history_quality_bias",
        "secondary_fraction",
        "secondary_lock_probability",
        "secondary_top_fraction"
      ]
    },
    "rollout_seed": {"type": "integer"},
    "repeat_index": {"type": "integer", "minimum": 0, "maximum": 2},
    "incumbent_curve": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"type": ["number", "null"]}
    },
    "failures": {"type": "array", "items": {"type": "object"}},
    "timing": {"type": "object"},
    "dependency_versions": {"type": "object"},
    "utility": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
  },
  "additionalProperties": true
}
