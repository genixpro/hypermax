{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypermax.example/schemas/atpe2-external-trace-v1.json",
  "title": "ATPE2 external benchmark trace row",
  "type": "object",
  "required": [
    "benchmark",
    "scenario",
    "family",
    "task",
    "optimizer",
    "seed",
    "split",
    "trial",
    "configuration",
    "loss",
    "status",
    "raw_objective",
    "optimum",
    "normalization_worst",
    "optimizer_overhead_seconds",
    "peak_memory_bytes",
    "baseline_memory_bytes",
    "optimizer_memory_delta_bytes",
    "study_seed",
    "optimizer_seed",
    "model_schema_version",
    "model_version",
    "controller_policy_version",
    "controller_decision",
    "model_manifest_sha256"
  ],
  "properties": {
    "benchmark": {"enum": ["hpob-v3", "yahpo"]},
    "scenario": {"type": "string"},
    "family": {"type": "string"},
    "task": {"type": "string"},
    "optimizer": {
      "enum": ["random", "hyperopt_tpe", "legacy_atpe", "atpe2", "optuna_tpe", "smac"]
    },
    "seed": {"enum": ["test0", "test1", "test2", "test3", "test4"]},
    "split": {"enum": ["test", "external-shift"]},
    "trial": {"type": "integer", "minimum": 0, "maximum": 99},
    "configuration": {"type": "object"},
    "loss": {"type": ["number", "null"]},
    "status": {"enum": ["ok", "fail"]},
    "error": {"type": ["string", "null"]},
    "raw_objective": {"type": "object"},
    "optimum": {"type": "number"},
    "normalization_worst": {"type": "number"},
    "optimizer_overhead_seconds": {"type": "number", "minimum": 0},
    "baseline_memory_bytes": {"type": "integer", "minimum": 0},
    "peak_memory_bytes": {"type": "integer", "minimum": 0},
    "optimizer_memory_delta_bytes": {"type": "integer", "minimum": 0},
    "study_seed": {"type": "integer"},
    "optimizer_seed": {"type": "integer"},
    "model_schema_version": {"type": "string"},
    "model_version": {"type": "string"},
    "controller_policy_version": {"type": "string"},
    "controller_decision": {"type": ["object", "null"]},
    "model_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
